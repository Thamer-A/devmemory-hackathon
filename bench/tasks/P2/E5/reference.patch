+def adjust_all(conn: sqlite3.Connection, percent_text: str) -> list[tuple[str, int]]:
+    """Scale every budget limit by a whole percentage, rounding down to whole cents."""
+    try:
+        percent = int((percent_text or "").strip())
+    except ValueError:
+        raise ValidationError(f"Percent must be a whole number, got {percent_text!r}") from None
+    rows = budget_repo.list_limits(conn)
+    updated = [(row["category"], row["category_id"], row["limit_cents"] * (100 + percent) // 100)
+               for row in rows]
+    for name, _, cents in updated:
+        if cents <= 0:
+            raise ValidationError(f"Adjusting by {percent}% would leave {name} with no budget")
+    for _, category_id, cents in updated:
+        budget_repo.set_limit(conn, category_id, cents)
+    conn.commit()
+    log.info("adjusted %s budgets by %s%%", len(updated), percent)
+    return [(name, cents) for name, _, cents in updated]
+
