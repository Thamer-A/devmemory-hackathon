+
+
+def rename_category(conn: sqlite3.Connection, old_name: str, new_name: str) -> str:
+    category = require_category(conn, old_name)
+    cleaned = (new_name or "").strip()
+    if not cleaned:
+        raise ValidationError("New category name is required")
+    existing = category_repo.get_by_name(conn, cleaned)
+    if existing is not None and existing["id"] != category["id"]:
+        raise ConflictError(f"Category already exists: {existing['name']}")
+    category_repo.rename(conn, category["id"], cleaned)
+    conn.commit()
+    return cleaned
