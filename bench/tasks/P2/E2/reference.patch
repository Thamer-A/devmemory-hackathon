--- a/ledgerly/repositories/categories.py
+++ b/ledgerly/repositories/categories.py
@@ -25,5 +25,16 @@ def get_by_name(conn: sqlite3.Connection, name: str) -> sqlite3.Row | None:
     ).fetchone()
 
 
+def count(conn: sqlite3.Connection) -> int:
+    return int(conn.execute("SELECT COUNT(*) FROM categories").fetchone()[0])
+
+
+def rename(conn: sqlite3.Connection, category_id: int, new_name: str) -> None:
+    try:
+        conn.execute("UPDATE categories SET name = ? WHERE id = ?", (new_name, category_id))
+    except sqlite3.IntegrityError:
+        raise ConflictError(f"Category already exists: {new_name}") from None
+
+
 def list_all(conn: sqlite3.Connection) -> list[sqlite3.Row]:
     return conn.execute("SELECT id, name FROM categories ORDER BY id").fetchall()
