diff --git a/ledgerly/repositories/budgets.py b/ledgerly/repositories/budgets.py
index cebcc41..fca8aea 100644
--- a/ledgerly/repositories/budgets.py
+++ b/ledgerly/repositories/budgets.py
@@ -16,6 +16,14 @@ def get_limit(conn: sqlite3.Connection, category_id: int) -> int | None:
     return None if row is None else int(row["limit_cents"])
 
 
+def highest(conn: sqlite3.Connection) -> sqlite3.Row | None:
+    return conn.execute(
+        "SELECT c.name AS category, b.limit_cents AS limit_cents"
+        " FROM budgets b JOIN categories c ON c.id = b.category_id"
+        " ORDER BY b.limit_cents DESC, c.name LIMIT 1"
+    ).fetchone()
+
+
 def list_limits(conn: sqlite3.Connection) -> list[sqlite3.Row]:
     return conn.execute(
         "SELECT c.id AS category_id, c.name AS category, b.limit_cents AS limit_cents"
