+def list_expenses(
+    conn: sqlite3.Connection, month: str | None = None, search: str | None = None
+) -> list[sqlite3.Row]:
+    clauses: list[str] = []
+    params: list[str] = []
+    if month is not None:
+        clauses.append("substr(e.spent_on, 1, 7) = ?")
+        params.append(month)
+    if search:
+        clauses.append("instr(lower(e.description), lower(?)) > 0")
+        params.append(search)
+    where = (" WHERE " + " AND ".join(clauses)) if clauses else ""
+    return conn.execute(_SELECT + where + " ORDER BY e.spent_on, e.id", params).fetchall()
 
 
