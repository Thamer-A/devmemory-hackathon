+def refunded_total(conn: sqlite3.Connection, expense_id: int) -> int:
+    """Sum of refunds (as a positive number of cents) already recorded against an expense."""
+    row = conn.execute(
+        "SELECT COALESCE(-SUM(amount_cents), 0) AS total FROM expenses WHERE refund_of = ?",
+        (expense_id,),
+    ).fetchone()
+    return int(row["total"])
