+def refund_expense(
+    conn: sqlite3.Connection, expense_id: int, amount_text: str | None = None
+) -> ExpenseRecord:
+    """Record a refund as a negative expense linked to the original; the original is untouched."""
+    original = expense_repo.get(conn, expense_id)
+    if original is None:
+        raise NotFoundError(f"No expense with id {expense_id}")
+    if original["amount_cents"] <= 0:
+        raise ConflictError("Only a regular expense can be refunded")
+    already = expense_repo.refunded_total(conn, expense_id)
+    cents = original["amount_cents"] - already if amount_text is None else money.parse_amount(amount_text)
+    if cents <= 0 or already + cents > original["amount_cents"]:
+        raise ConflictError(f"Refund exceeds the original amount of expense {expense_id}")
+    created_at = datetime.now().isoformat(timespec="seconds")
+    when = date.today().strftime(config.DATE_FORMAT)
+    refund_id = expense_repo.add(
+        conn, -cents, f"Refund of #{expense_id}: {original['description']}"[: config.MAX_DESCRIPTION_LEN],
+        original["category_id"], when, created_at, refund_of=expense_id,
+    )
+    conn.commit()
+    log.info("refunded %s cents of expense %s", cents, expense_id)
+    return get_expense(conn, refund_id)
+
+
