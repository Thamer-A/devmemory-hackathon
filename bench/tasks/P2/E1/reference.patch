diff --git a/ledgerly/repositories/expenses.py b/ledgerly/repositories/expenses.py
index 5db24fd..5503eb2 100644
--- a/ledgerly/repositories/expenses.py
+++ b/ledgerly/repositories/expenses.py
@@ -36,6 +36,15 @@ def list_expenses(conn: sqlite3.Connection, month: str | None = None) -> list[sq
     ).fetchall()
 
 
+def largest(conn: sqlite3.Connection, limit: int, month: str | None = None) -> list[sqlite3.Row]:
+    where = "" if month is None else " WHERE substr(e.spent_on, 1, 7) = ?"
+    args: tuple = () if month is None else (month,)
+    return conn.execute(
+        _SELECT + where + " ORDER BY e.amount_cents DESC, e.spent_on, e.id LIMIT ?",
+        (*args, limit),
+    ).fetchall()
+
+
 def delete(conn: sqlite3.Connection, expense_id: int) -> bool:
     cur = conn.execute("DELETE FROM expenses WHERE id = ?", (expense_id,))
     return cur.rowcount > 0
