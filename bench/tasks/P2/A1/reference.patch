+def format_plain(cents: int) -> str:
+    """Plain decimal text such as "12.50" (no currency, no separators)."""
+    sign = "-" if cents < 0 else ""
+    whole, fraction = divmod(abs(cents), 100)
+    return f"{sign}{whole}.{fraction:02d}"
