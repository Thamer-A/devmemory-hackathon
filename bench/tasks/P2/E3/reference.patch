@@ -87,6 +87,27 @@ def list_expenses(conn: sqlite3.Connection, month: str | None = None) -> list[Ex
     return [_to_record(row) for row in expense_repo.list_expenses(conn, month)]
 
 
+def fix_legacy_dates(conn: sqlite3.Connection) -> int:
+    """Rewrite day-first legacy dates (14/03/2025) as ISO. Unrecognised values are left alone."""
+    fixed = 0
+    for row in expense_repo.all_dates(conn):
+        value = (row["spent_on"] or "").strip()
+        try:
+            validate_spent_on(value)
+            continue
+        except ValidationError:
+            pass
+        try:
+            parsed = datetime.strptime(value, config.LEGACY_DATE_FORMAT)
+        except ValueError:
+            log.warning("expense %s has an unrecognised date %r", row["id"], value)
+            continue
+        expense_repo.set_date(conn, row["id"], parsed.strftime(config.DATE_FORMAT))
+        fixed += 1
+    conn.commit()
+    return fixed
+
+
 def delete_expense(conn: sqlite3.Connection, expense_id: int) -> None:
     if not expense_repo.delete(conn, expense_id):
         raise NotFoundError(f"No expense with id {expense_id}")
