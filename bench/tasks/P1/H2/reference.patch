@@ -0,0 +1,12 @@
+--!strict
+local Config = require(script.Parent.Config)
+
+local DailyReward = {}
+
+-- Coins for a given streak length: base plus a bonus per streak day, with the streak capped.
+function DailyReward.coinsFor(streak: number): number
+	local days = math.min(math.max(streak, 1), Config.DailyStreakCap)
+	return Config.DailyRewardBase + Config.DailyRewardPerStreakDay * days
+end
+
+return DailyReward
