@@ -185,6 +185,9 @@ local function onEnemyTouched(record: EnemyRecord, other: BasePart)
 	record.lastHit[player] = now
 
 	local damage = Config.Enemies[record.kind].damage
+	if RoundService.isPlaying() and RoundService.getTimeLeft() <= Config.FinalStretchSeconds then
+		damage *= Config.FinalStretchDamageMultiplier
+	end
 	humanoid:TakeDamage(damage)
 	Remotes.get("EnemyHit"):FireClient(player, record.kind, damage)
 end
