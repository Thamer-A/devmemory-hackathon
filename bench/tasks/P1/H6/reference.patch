 	local after = MathUtil.clamp(before + amount, 0, Config.MaxCoins)
 	data.coins = after
+	if after > before then
+		-- Spending never lowers lifetime earnings.
+		data.lifetimeCoins = (data.lifetimeCoins or 0) + (after - before)
